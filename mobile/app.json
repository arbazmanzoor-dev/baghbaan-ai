{
  "expo": {
    "name": "BaghBaan AI",
    "slug": "baghbaan-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.baghbaan.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.baghbaan.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2f5d3a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#1f4229",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "en",
            "hi",
            "ur"
          ]
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "BaghBaan AI uses the camera to photograph apple leaves for disease diagnosis.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BaghBaan AI lets you choose a leaf photo from your gallery for diagnosis.",
          "microphonePermission": false
        }
      ],
      "react-native-fast-tflite",
      "expo-secure-store"
    ],
    "scheme": "baghbaan",
    "experiments": {
      "typedRoutes": true
    }
  }
}
